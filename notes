Navbar.tsx

import { UserButton } from "@clerk/nextjs";
import Link from "next/link";
import { LayoutDashboard, PlusCircle, History } from "lucide-react";

export default function Navbar() {
  return (
    <nav className="fixed bottom-6 left-1/2 -translate-x-1/2 bg-white/80 backdrop-blur-md border border-indigo-50 shadow-2xl rounded-2xl px-6 py-3 flex items-center gap-8 z-50">
      <Link href="/" className="text-gray-400 hover:text-[#4B0082] transition-colors">
        <LayoutDashboard size={24} />
      </Link>
      <Link href="/add" className="bg-[#7F00FF] p-3 rounded-full text-white shadow-lg shadow-purple-200 hover:scale-110 transition-transform">
        <PlusCircle size={28} />
      </Link>
      <Link href="/history" className="text-gray-400 hover:text-[#4B0082] transition-colors">
        <History size={24} />
      </Link>
      <div className="border-l pl-4 border-gray-100">
        <UserButton afterSignOutUrl="/sign-in" />
      </div>
    </nav>
  );
}


Salary.tsx

"use client";
import { useState, useEffect, useMemo } from "react";

export default function StudentBudgetTracker() {
  const [amount, setAmount] = useState("");
  const [category, setCategory] = useState<"pocketmoney" | "salary">("pocketmoney");
  const [date, setDate] = useState(() => new Date().toISOString().split("T")[0]);
  const [transactions, setTransactions] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState(false);

  // ✅ Fixed: fetch once only — category toggle only changes the display, not the data
  const fetchTransactions = async () => {
    try {
      const res = await fetch("/api/transactions");
      const data = await res.json();
      setTransactions(
        data
          .map((t: any) => ({ ...t, amount: Number(t.amount) }))
          // ✅ Fixed: sort ascending by date so balance runs in correct chronological order
          .sort((a: any, b: any) => new Date(a.date).getTime() - new Date(b.date).getTime())
      );
    } catch (err) {
      console.error("Error fetching transactions", err);
    }
  };

  useEffect(() => {
    fetchTransactions();
  }, [success]); // ✅ Fixed: removed `category` from deps — no need to refetch on tab switch

  // ✅ Fixed: correct balance calculation
  // Income adds to its own pool. Expenses deduct from the pool stored in their `source` field.
  // If no source is stored, expenses deduct proportionally from total income.
  const balances = useMemo(() => {
    let salaryBal = 0;
    let pocketBal = 0;

    for (const t of transactions) {
      if (t.type === "salary") {
        salaryBal += t.amount;
      } else if (t.type === "pocketmoney") {
        pocketBal += t.amount;
      } else if (t.type === "expense") {
        // Use `source` field if present, otherwise deduct from salary first then pocket
        const source = t.source ?? (salaryBal > 0 ? "salary" : "pocketmoney");
        if (source === "salary") salaryBal -= t.amount;
        else pocketBal -= t.amount;
      }
    }

    return { salary: salaryBal, pocketmoney: pocketBal };
  }, [transactions]);

  const isValid = Number(amount) > 0 && !!date;

  const saveTransaction = async () => {
    if (!isValid) return;
    setLoading(true);
    setError("");

    try {
      const res = await fetch("/api/transactions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: category === "salary" ? "Monthly Salary" : "Pocket Money",
          amount: Number(amount),
          type: category,
          date,
        }),
      });

      if (!res.ok) throw new Error("Failed to save");
      setAmount("");
      setSuccess(true);
      setTimeout(() => setSuccess(false), 3000);
    } catch {
      setError("Failed to connect to database.");
    } finally {
      setLoading(false);
    }
  };

  const currentBalance = balances[category];

  return (
    <div className="min-h-screen bg-[#F8F9FF] flex items-start justify-center p-8">
      <div className="bg-white rounded-2xl shadow-md border border-[#E6E6FA] p-8 w-full max-w-md">

        {/* Category Switcher */}
        <div className="flex bg-[#F1F0FB] p-1 rounded-xl mb-6">
          <button
            onClick={() => setCategory("pocketmoney")}
            className={`flex-1 py-2 text-sm font-bold rounded-lg transition ${
              category === "pocketmoney" ? "bg-[#7F00FF] text-white shadow-md" : "text-gray-500"
            }`}
          >
            Pocket Money
          </button>
          <button
            onClick={() => setCategory("salary")}
            className={`flex-1 py-2 text-sm font-bold rounded-lg transition ${
              category === "salary" ? "bg-[#7F00FF] text-white shadow-md" : "text-gray-500"
            }`}
          >
            Salary
          </button>
        </div>

        {/* Balance Display */}
        <div className="text-center mb-8">
          <p className="text-xs font-medium text-gray-400 uppercase tracking-widest">
            {category === "salary" ? "Salary Remaining" : "Pocket Money Remaining"}
          </p>
          {/* ✅ Fixed: toLocaleString for readable numbers */}
          <h2 className={`text-4xl font-black mt-1 ${currentBalance < 0 ? "text-red-500" : "text-[#1A1A2E]"}`}>
            ₹{currentBalance.toLocaleString()}
          </h2>
          {currentBalance < 0 && (
            <p className="text-xs text-red-400 mt-1">You have exceeded your {category === "salary" ? "salary" : "pocket money"}</p>
          )}
        </div>

        <div className="space-y-4">
          <div>
            <label className="block text-xs font-medium text-gray-500 mb-1 uppercase">
              Add {category === "salary" ? "Salary" : "Pocket Money"} (₹)
            </label>
            <input
              type="number"
              placeholder="Enter amount"
              value={amount}
              min={1}
              onChange={(e) => setAmount(e.target.value)}
              className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 outline-none focus:border-[#7F00FF] transition text-[#1A1A2E]"
            />
          </div>

          <div>
            <label className="block text-xs font-medium text-gray-500 mb-1 uppercase">Date</label>
            <input
              type="date"
              value={date}
              onChange={(e) => setDate(e.target.value)}
              className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 outline-none focus:border-[#7F00FF] transition text-[#1A1A2E]"
            />
          </div>

          {error && <p className="text-sm text-red-600 bg-red-50 p-3 rounded-xl">{error}</p>}
          {success && (
            <p className="text-sm text-green-600 bg-green-50 p-3 rounded-xl">
              ✓ Added to {category === "salary" ? "Salary" : "Pocket Money"}
            </p>
          )}

          <button
            onClick={saveTransaction}
            disabled={!isValid || loading}
            className="w-full bg-[#7F00FF] hover:bg-[#4B0082] disabled:opacity-40 text-white font-bold py-3 rounded-xl transition-all"
          >
            {loading ? "Saving..." : `Add ${category === "salary" ? "Salary" : "Pocket Money"}`}
          </button>
        </div>
      </div>
    </div>
  );
}

