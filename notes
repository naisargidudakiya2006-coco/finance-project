Expense.tsx

"use client";
import { useState } from "react";

// ✅ Updated categories list
const CATEGORIES = ["Food", "Travel", "Bills", "Shopping", "Other"];

export default function Expense() {
  const [amount, setAmount] = useState("");
  const [category, setCategory] = useState("Food");
  const [customCategory, setCustomCategory] = useState("");
  const [date, setDate] = useState(() => new Date().toISOString().split("T")[0]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [success, setSuccess] = useState(false);

  // Determine the final name to send to the database
  const finalCategoryName = category === "Other" ? customCategory.trim() : category;

  // Validation: Amount must be > 0, date must exist, and if "Other" is picked, custom input must not be empty
  const isValid = 
    Number(amount) > 0 && 
    !!date && 
    (category !== "Other" || customCategory.trim() !== "");

  const addExpense = async () => {
    if (!isValid) return;
    setLoading(true); 
    setError(""); 
    setSuccess(false);

    try {
      const res = await fetch("/api/transactions", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ 
          name: finalCategoryName, 
          amount: Number(amount), 
          type: "expense", 
          // Defaulting source to "expense" or removing if your DB allows null, 
          // keeping a default string if your schema requires it.
          source: "general", 
          date 
        }),
      });

      if (!res.ok) throw new Error();

      // Reset form
      setAmount(""); 
      setCustomCategory(""); 
      setCategory("Food");
      setDate(new Date().toISOString().split("T")[0]);
      setSuccess(true); 
      setTimeout(() => setSuccess(false), 3000);

    } catch { 
      setError("Database connection failed."); 
    } finally { 
      setLoading(false); 
    }
  };

  return (
    <div className="min-h-screen bg-[#F8F9FF] flex items-start justify-center p-8">
      <div className="bg-white rounded-2xl shadow-md border border-[#E6E6FA] p-8 w-full max-w-md">
        <h1 className="text-2xl font-bold text-[#4B0082] mb-1">Add Expense</h1>
        <p className="text-sm text-gray-400 mb-6">Track your daily spending</p>
        
        <div className="space-y-4">
          {/* Amount Input */}
          <div>
            <label className="block text-xs text-gray-500 mb-1 uppercase font-semibold">Amount (₹)</label>
            <input 
              type="number" 
              placeholder="0" 
              min={1} 
              value={amount} 
              onChange={e => setAmount(e.target.value)} 
              className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 focus:border-[#7F00FF] outline-none" 
            />
          </div>

          {/* Category Dropdown */}
          <div>
            <label className="block text-xs text-gray-500 mb-1 uppercase font-semibold">Category</label>
            <select 
              value={category} 
              onChange={e => setCategory(e.target.value)} 
              className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 outline-none bg-white"
            >
              {CATEGORIES.map(c => <option key={c} value={c}>{c}</option>)}
            </select>
          </div>

          {/* Custom Category Input - Only shows if "Other" is selected */}
          {category === "Other" && (
            <div>
              <label className="block text-xs text-gray-500 mb-1 uppercase font-semibold">Specify Category</label>
              <input 
                type="text" 
                placeholder="Enter custom category" 
                value={customCategory} 
                onChange={e => setCustomCategory(e.target.value)} 
                className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 focus:border-[#7F00FF] outline-none" 
              />
            </div>
          )}

          {/* Date Input */}
          <div>
            <label className="block text-xs text-gray-500 mb-1 uppercase font-semibold">Date</label>
            <input 
              type="date" 
              value={date} 
              onChange={e => setDate(e.target.value)} 
              className="w-full border-2 border-[#E6E6FA] rounded-xl p-3 focus:border-[#7F00FF] outline-none" 
            />
          </div>

          {/* Messages */}
          {error   && <p className="text-sm text-red-600 bg-red-50 p-3 rounded-xl">✕ {error}</p>}
          {success && <p className="text-sm text-green-600 bg-green-50 p-3 rounded-xl">✓ Expense saved successfully</p>}

          {/* Submit Button */}
          <button 
            onClick={addExpense} 
            disabled={!isValid || loading} 
            className="w-full bg-[#7F00FF] hover:bg-[#4B0082] disabled:opacity-40 text-white font-bold py-3 rounded-xl transition-all"
          >
            {loading ? "Saving..." : "Add Expense"}
          </button>
        </div>
      </div>
    </div>
  );
}

History.tsx


"use client";
import { useEffect, useState } from "react";

export default function SimpleHistory() {
  const [data, setData] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);

  const fetchData = async () => {
    try {
      const res = await fetch("/api/transactions");
      const result = await res.json();
      // Oldest to Newest
      const sorted = result.sort((a: any, b: any) => 
        new Date(a.date).getTime() - new Date(b.date).getTime()
      );
      setData(sorted);
    } catch (err) {
      console.error("Fetch error:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const deleteItem = async (id: string | number) => {
  if (!confirm("Delete this entry?")) return;

  try {
    // ✅ This matches the folder structure: /api/transactions/[id]
    const res = await fetch(`/api/transactions/${id}`, { 
      method: "DELETE" 
    });

    if (res.ok) {
      // Remove from UI state
      setData((prev) => prev.filter((item) => item.id !== id));
    } else {
      const errorData = await res.json();
      console.error("Server says:", errorData);
      alert("Delete failed on server. Check if the ID exists.");
    }
  } catch (err) {
    console.error("Network error:", err);
    alert("Check your internet or server connection.");
  }
};
  if (loading) return <div className="p-10 text-center text-gray-400">Loading history...</div>;

  return (
    <div className="max-w-xl mx-auto p-6">
      <h2 className="text-xl font-bold text-gray-800 mb-6 border-b pb-2">History</h2>
      
      <div className="space-y-3">
        {data.length === 0 ? (
          <p className="text-center text-gray-400 py-10">No transactions found.</p>
        ) : (
          data.map((item) => {
            const isIncome = item.type === "salary" || item.type === "pocketmoney";
            // Use _id if your database is MongoDB, otherwise use id
            const itemId = item.id || item._id;

            return (
              <div key={itemId} className="flex items-center justify-between bg-white p-4 rounded-xl border border-gray-100 shadow-sm">
                <div className="flex flex-col">
                  <span className="font-semibold text-sm">
                    {isIncome ? "💰 Income" : `💸 ${item.name}`}
                  </span>
                  <span className="text-[10px] text-gray-400">
                    {new Date(item.date).toLocaleDateString()}
                  </span>
                </div>

                <div className="flex items-center gap-6">
                  <span className={`font-bold ${isIncome ? "text-green-500" : "text-red-500"}`}>
                    {isIncome ? "+" : "-"} ₹{Number(item.amount).toLocaleString()}
                  </span>

                  <button 
                    onClick={() => deleteItem(itemId)}
                    className="text-gray-300 hover:text-red-500 p-2"
                  >
                    {/* Simple Trash Icon */}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                </div>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

