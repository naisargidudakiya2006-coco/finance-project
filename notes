Home.tsx


"use client";
import { useEffect, useState, useMemo } from "react";
import { 
  BarChart, Bar, XAxis, YAxis, Tooltip, PieChart, Pie, Cell, 
  ResponsiveContainer, CartesianGrid, Legend 
} from "recharts";
import { Wallet, Landmark, TrendingDown, ReceiptText, ArrowUpRight } from "lucide-react";

// Colors extracted from your SpendIQ logo
const COLORS = ["#4B0082", "#7F00FF", "#FF8042", "#A45EE5", "#00C49F", "#FFBB28"];

export default function SpendIQDashboard() {
  const [data, setData] = useState([]);
  const [loading, setLoading] = useState(true);

  // FETCH DATA
  useEffect(() => {
    fetch("/api/transactions")
      .then(res => res.json())
      .then(raw => {
        const formatted = raw.map((item) => ({
          ...item,
          amount: Number(item.amount)
        }));
        setData(formatted);
        setLoading(false);
      })
      .catch(err => console.error(err));
  }, []);

  // 📈 CALCULATIONS (Salary vs Pocket Money logic)
  const stats = useMemo(() => {
    let salaryLeft = 0;
    let pocketLeft = 0;
    let totalExpense = 0;

    // Process chronologically to track balance correctly
    const chronological = [...data].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

    chronological.forEach(t => {
      if (t.type === "salary") salaryLeft += t.amount;
      else if (t.type === "pocketmoney") pocketLeft += t.amount;
      else if (t.type === "expense") {
        totalExpense += t.amount;
        if (t.source === "salary") salaryLeft -= t.amount;
        else pocketLeft -= t.amount;
      }
    });

    return { salaryLeft, pocketLeft, totalExpense };
  }, [data]);

  // 🥧 PIE CHART DATA (Category distribution)
  const pieData = useMemo(() => {
    const expenses = data.filter(i => i.type === "expense");
    const groups = expenses.reduce((acc, curr) => {
      acc[curr.name] = (acc[curr.name] || 0) + curr.amount;
      return acc;
    }, {});
    return Object.entries(groups).map(([name, value]) => ({ name, value }));
  }, [data]);

  if (loading) return <div className="flex h-screen items-center justify-center text-indigo-600 font-bold">Loading SpendIQ...</div>;

  return (
    <div className="p-4 md:p-8 max-w-7xl mx-auto space-y-8 bg-[#F8F9FF] min-h-screen font-sans">
      
      {/* 🚀 HEADER / LOGO SECTION */}
      <div className="flex items-center gap-3">
        <div className="w-12 h-12 bg-gradient-to-tr from-[#4B0082] to-[#FF8042] rounded-xl flex items-center justify-center text-white font-bold text-2xl shadow-lg">
          S
          </div>
        <div>
          <h1 className="text-2xl font-black text-[#1A1A2E] tracking-tight">SpendIQ</h1>
          <p className="text-xs text-gray-500 font-medium italic">Smarter Money. Better Decisions.</p>
        </div>
      </div>

      {/* 💰 TOP CARDS SECTION */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Salary Card */}
        <div className="bg-white p-6 rounded-3xl shadow-sm border border-indigo-50 relative overflow-hidden group hover:shadow-md transition-all">
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <Landmark size={80} color="#4B0082" />
          </div>
          <p className="text-gray-400 text-sm font-bold uppercase tracking-wider">Salary Left</p>
          <h2 className="text-3xl font-black text-[#4B0082] mt-2">₹{stats.salaryLeft.toLocaleString()}</h2>
          <div className="mt-4 flex items-center text-xs text-green-500 font-bold">
            <ArrowUpRight size={14} /> Active Account
          </div>
        </div>

        {/* Pocket Money Card */}
        <div className="bg-white p-6 rounded-3xl shadow-sm border border-purple-50 relative overflow-hidden group hover:shadow-md transition-all">
          <div className="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <Wallet size={80} color="#7F00FF" />
          </div>
          <p className="text-gray-400 text-sm font-bold uppercase tracking-wider">Pocket Money</p>
          <h2 className="text-3xl font-black text-[#7F00FF] mt-2">₹{stats.pocketLeft.toLocaleString()}</h2>
          <div className="mt-4 flex items-center text-xs text-purple-400 font-bold">
             Personal Savings
          </div>
        </div>

        {/* Total Expense Card */}
        <div className="bg-gradient-to-br from-[#FF8042] to-[#ff9b6a] p-6 rounded-3xl shadow-lg text-white relative overflow-hidden group">
          <div className="absolute top-0 right-0 p-4 opacity-20">
            <TrendingDown size={80} color="#fff" />
          </div>
          <p className="text-white/80 text-sm font-bold uppercase tracking-wider">Total Outflow</p>
          <h2 className="text-3xl font-black mt-2">₹{stats.totalExpense.toLocaleString()}</h2>
          <div className="mt-4 flex items-center text-xs font-bold bg-white/20 w-fit px-2 py-1 rounded-full">
            All Categories
          </div>
        </div>
      </div>

      {/* 📊 ANALYTICS SECTION */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Category Breakdown (Pie) */}
        <div className="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
          <div className="flex items-center gap-2 mb-6">
            <div className="p-2 bg-indigo-50 rounded-lg text-indigo-600"><ReceiptText size={20} /></div>
            <h3 className="text-lg font-bold text-gray-800">Spending by Category</h3>
          </div>
          <div className="h-80">
            <ResponsiveContainer width="100%" height="100%">
              <PieChart>
                <Pie 
                  data={pieData} 
                  dataKey="value" 
                  nameKey="name" 
                  innerRadius={70} 
                  outerRadius={100} 
                  paddingAngle={5}
                  stroke="none"
                >
                  {pieData.map((_, i) => <Cell key={i} fill={COLORS[i % COLORS.length]} />)}
                </Pie>
                <Tooltip 
                   contentStyle={{ borderRadius: '15px', border: 'none', boxShadow: '0 10px 15px -3px rgba(0,0,0,0.1)' }}
                />
                <Legend iconType="circle" layout="vertical" align="right" verticalAlign="middle" />
              </PieChart>
            </ResponsiveContainer>
          </div>
        </div>

        {/* 📜 RECENT HISTORY */}
        <div className="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
          <div className="flex justify-between items-center mb-6">
            <h3 className="text-lg font-bold text-gray-800">Latest Activity</h3>
            <button className="text-xs font-bold text-indigo-600 hover:underline">View All</button>
          </div>
          <div className="space-y-4 max-h-[320px] overflow-y-auto pr-2">
            {data.slice(-5).reverse().map((item) => {
              const isIncome = item.type === "salary" || item.type === "pocketmoney";
              return (
                <div key={item.id} className="flex items-center justify-between p-4 bg-gray-50 rounded-2xl hover:bg-gray-100 transition-colors">
                  <div className="flex items-center gap-4">
                    <div className={`w-10 h-10 rounded-xl flex items-center justify-center font-bold ${isIncome ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'}`}>
                      {isIncome ? "+" : "-"}
                    </div>
                    <div>
                      <p className="text-sm font-bold text-gray-800">{isIncome ? item.type.toUpperCase() : item.name}</p>
                      <p className="text-[10px] text-gray-400 font-medium uppercase tracking-tighter">{new Date(item.date).toLocaleDateString()}</p>
                    </div>
                  </div>
                  <span className={`font-black text-sm ${isIncome ? 'text-green-500' : 'text-gray-800'}`}>
                    ₹{item.amount.toLocaleString()}
                  </span>
                </div>
              );
            })}
            {data.length === 0 && <p className="text-center text-gray-400 py-10 italic">Your SpendIQ is empty.</p>}
          </div>
        </div>
      </div>
    </div>
  );
}

